{
  "name": "draw-your-font",
  "version": "0.1.0",
  "description": "Turn a photo of your handwriting into a real font (TTF/WOFF/WOFF2) - free, open source, no uploads.",
  "license": "MIT",
  "bin": {
    "draw-your-font": "src/cli.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/e2e.js"
  },
  "keywords": [
    "font",
    "handwriting",
    "ttf",
    "woff2",
    "potrace",
    "claude-skill",
    "handwriting-font"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danilo-znamerovszkij/draw-your-font.git"
  },
  "dependencies": {
    "pdfkit": "^0.15.0",
    "potrace": "^2.1.8",
    "sharp": "^0.33.4",
    "svg2ttf": "^6.0.3",
    "svgpath": "^2.6.0",
    "ttf2woff": "^3.0.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "opentype.js": "^1.3.4"
  }
}
